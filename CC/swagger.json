    "/api/google-calendar-events": {
      "get": {
        "summary": "取得指定月份的 Google 日曆事件列表 (Query 參數)",
        "description": "透過 Query Parameters 傳入 userId、year 與 month，查詢該使用者在指定月份（含跨月份邊界）的 Google 日曆事件。",
        "tags": ["Google Calendar"],
        "parameters": [
          {
            "in": "query",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "使用者 ID",
            "example": 1
          },
          {
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "查詢年份",
            "example": 2026
          },
          {
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "查詢月份 (1-12)",
            "example": 8
          }
        ],
        "responses": {
          "200": {
            "description": "成功取得日曆事件列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "資料庫內的事件 ID",
                        "example": 101
                      },
                      "googleEventId": {
                        "type": "string",
                        "description": "Google 日曆原生的事件 ID (可存於前端 state)",
                        "example": "abc123xyz"
                      },
                      "summary": {
                        "type": "string",
                        "description": "事件標題",
                        "example": "團隊例會"
                      },
                      "description": {
                        "type": "string",
                        "nullable": true,
                        "description": "事件描述",
                        "example": "討論專題進度與分工"
                      },
                      "location": {
                        "type": "string",
                        "nullable": true,
                        "description": "活動地點",
                        "example": "線上會議室"
                      },
                      "startTime": {
                        "type": "string",
                        "format": "date-time",
                        "description": "開始時間 (ISO 8601 格式)",
                        "example": "2026-08-20T10:00:00.000Z"
                      },
                      "endTime": {
                        "type": "string",
                        "format": "date-time",
                        "description": "結束時間 (ISO 8601 格式)",
                        "example": "2026-08-20T11:30:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "缺少必要參數或日期格式無效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "缺少必要參數: userId, year, month"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "伺服器內部錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "伺服器錯誤"
                    },
                    "error": {
                      "type": "string",
                      "example": "錯誤詳細訊息..."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
